{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.yureka.one",
        "EXPO_PUBLIC_APP_URL": "https://app.yureka.one",
        "EXPO_PUBLIC_LANDING_URL": "https://yureka.one"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.yureka.one",
        "EXPO_PUBLIC_APP_URL": "https://app.yureka.one",
        "EXPO_PUBLIC_LANDING_URL": "https://yureka.one"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.yureka.one",
        "EXPO_PUBLIC_APP_URL": "https://app.yureka.one",
        "EXPO_PUBLIC_LANDING_URL": "https://yureka.one",
        "EXPO_PUBLIC_IOS_PAID_TEAM": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "replace-in-app-store-connect"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
