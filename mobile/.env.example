# Copy to `.env.local` for local dev / EAS secrets for cloud builds.
# All EXPO_PUBLIC_* vars are baked into the app at build time.

EXPO_PUBLIC_API_URL=https://app.yureka.one
EXPO_PUBLIC_APP_URL=https://app.yureka.one
EXPO_PUBLIC_LANDING_URL=https://yureka.one

# Required — auth is disabled without these (same Supabase project as the web app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 when prebuilding with a paid Apple Developer account (Sign in with Apple + Universal Links).
# EXPO_PUBLIC_IOS_PAID_TEAM=1

# Personal Team local dev bundle (production one.yureka.app is registered to the org account).
# EXPO_PUBLIC_IOS_BUNDLE_ID=one.yureka.app.dev
