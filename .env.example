# Copy to `.env` and fill values locally. Never commit `.env`.
# Set the same keys in your host dashboard for production.

# --- EC2 deploy (local only — do not commit yureka.pem) ---
# Place your AWS key pair at ./yureka.pem (chmod 400). Gitignored via *.pem.
# EC2_HOST=13.57.223.228
# EC2_USER=ec2-user
# EC2_KEY=./yureka.pem
# EC2_APP_DIR=/opt/yureka-one
# Then: pnpm deploy:ec2

# --- Google OAuth (optional; waitlist / Gmail flows) ---
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cross-Account Protection (RISC). Service account JSON with RISC Configuration Admin.
# GOOGLE_RISC_SA_JSON=./secrets/risc-sa.json
# RISC_RECEIVER_URL=https://app.yureka.one/api/auth/google-risc
# RISC_AUTO_REGISTER=true
# Extra OAuth client IDs for SET audience checks (comma-separated).
# GOOGLE_RISC_AUDIENCE=
# Encrypts stored Gmail refresh tokens (ledger background sync). Falls back to GOOGLE_CLIENT_SECRET.
# LEDGER_TOKEN_SECRET=
# Set false to disable weekly background Gmail resync.
# LEDGER_BACKGROUND_SYNC=true

# Leave empty for same-origin /api/scan-email in production.
# Only set if scoring must hit a different host.
# VITE_SCORE_API_BASE=

# --- Auth / data (browser + server) ---
# Supabase project ref: sfdqxpybtmsfbjppoydh
VITE_SUPABASE_URL=https://sfdqxpybtmsfbjppoydh.supabase.co
# Prefer anon key; new dashboard “publishable” key is accepted as an alias.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://sfdqxpybtmsfbjppoydh.supabase.co
SUPABASE_PROJECT_REF=sfdqxpybtmsfbjppoydh
# Postgres password (Dashboard → Project Settings → Database). Used by `pnpm supabase:link` / `pnpm supabase:push`.
# SUPABASE_DB_PASSWORD=
# Server-only. Required for privileged writes when client RLS blocks anon.
SUPABASE_SERVICE_ROLE_KEY=
# Goldback: leave unset to use Supabase (service role required). Set to "file" for local disk store only.
# GOLDBACK_STORE=file
# Blog cover/inline images upload to the public `blog-images` Storage bucket.
# If the bucket is missing, the API creates it. Optional SQL: supabase/migrations/008_blog_images.sql
# If admin offer delete says "Could not find the table 'public.offers'", run `pnpm supabase:push`.
# Migrations live in supabase/migrations/ (001 goldback, etc.).
# Optional: waitlist query budget (default 10000ms).
# SUPABASE_WAITLIST_TIMEOUT_MS=10000
# SUPABASE_CIRCUIT_MS=20000

# --- Waitlist gate (off by default — users onboard straight to dashboard) ---
# Set both to true to require join-waitlist / waiting again.
# WAITLIST_REQUIRED=true
# VITE_WAITLIST_REQUIRED=true

# --- OpenAI (score refine + planning insights) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Backoffice (/admin) ---
ADMIN_PASSWORD=
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=
# Invite links expire after this many hours (default 72).
# ADMIN_INVITE_TTL_HOURS=72
# Optional dedicated HMAC secret for invite tokens (falls back to ADMIN_SESSION_SECRET).
# ADMIN_INVITE_SECRET=

# --- Public site URLs (split hosts) ---
# Landing: https://yureka.one
# Product app: https://app.yureka.one
# Admin: https://admin.yureka.one
# Brand portal: https://brand.yureka.one
VITE_LANDING_URL=https://yureka.one
VITE_APP_URL=https://app.yureka.one
VITE_ADMIN_PORTAL_URL=https://admin.yureka.one
VITE_BRAND_URL=https://brand.yureka.one
VITE_WANDERWORLD_URL=https://wanderworld.yureka.one
# Required to seed the first WanderWorld owner when the team is empty.
# Must match the email you sign in with on wanderworld.yureka.one.
# If unset, auto-bootstrap is disabled (invite via admin Club → WanderWorld instead).
WANDERWORLD_BOOTSTRAP_EMAIL=you@example.com
# WanderWorld persistence: file | dual (default) | supabase
WANDERWORLD_STORE=dual
# Brand portal: leave unset to use Supabase (service role required). Set to "file" for local disk store only.
# BRAND_STORE=file
# If brand APIs say the table is missing, run supabase/migrations/012_brand_portal.sql or `pnpm supabase:push`.
# Add https://brand.yureka.one/brand/login (and localhost) to Supabase Auth redirect URLs.
APP_ORIGIN=https://app.yureka.one
FRONTEND_URL=https://app.yureka.one
PUBLIC_APP_URL=https://app.yureka.one

# --- Google AdSense ---
# In AdSense → Sites, add https://yureka.one (root domain — Google usually rejects app.yureka.one).
# Verify with https://yureka.one/ads.txt (same file serves on app.yureka.one/ads.txt).
# The publisher script loads on yureka.one + app.yureka.one; the ad unit only shows on app home.
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-8129795758611953
# Set false to disable all in-app ads without removing the client ID.
# VITE_GOOGLE_ADSENSE_ENABLED=true
# Home page footer ad unit (slot from AdSense → Ads → By ad unit)
VITE_ADSENSE_SLOT_HOME_FOOTER=9162143879
# ads.txt is served from /ads.txt (required for verification).

# --- Outbound email (Express only: approvals, invites, score, admin notify) ---
# Provider order: RESEND_API_KEY > SMTP_* > GMAIL_*
# yureka.one inbound is Cloudflare Email Routing (receive-only), so sending
# requires a transactional provider. Verify the domain in Resend first.
# Also used for account deletion: member confirmation + ADMIN_EMAILS notify.
RESEND_API_KEY=
MAIL_FROM_EMAIL=support@yureka.one
MAIL_FROM_NAME=Yureka One
# Optional override for deletion-request alerts (defaults to ADMIN_EMAILS)
# DELETION_NOTIFY_EMAILS=

# Optional generic SMTP instead of Resend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Legacy fallback. Gmail can only send as the authenticated mailbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Payments (Razorpay Checkout) then Hubble voucher issue ---
# Public key id + secret. Aliases RAZORPAY_LIVE_API_KEY / RAZORPAY_LIVE_KEY_SECRET also work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook HMAC from Razorpay dashboard (payment.captured backup)
# RAZORPAY_WEBHOOK_SECRET=

# --- Gift cards catalog / fulfillment (Express only) ---
HUBBLE_CLIENT_ID=
HUBBLE_CLIENT_SECRET=
HUBBLE_API_BASE=
# Webhook HMAC secret for order / catalog callbacks
HUBBLE_WEBHOOK_SECRET=
# Skip Razorpay and debit the Hubble wallet directly. Keep false in production.
# GIFTCARD_DIRECT_ISSUE=false
# GIFTCARD_CHECKOUT_ENABLED=false

# --- Marketplace offers (Express only) ---
CUELINKS_API_TOKEN=
CUELINKS_API_BASE=
CUELINKS_OFFERS_PATH=
CUELINKS_INDIA_ONLY=true
